# Build-time configuration for the LLMDash mobile app.
# The value of LLMDASH_SERVER_URL is baked into the Android APK at build time
# and cannot be changed by the end user at runtime. Fork this repo and edit
# this file to ship a build pointing at your own LLMDash instance.
#
# Examples:
#   LLMDASH_SERVER_URL=https://ai.redforged.eu/
#   LLMDASH_SERVER_URL=http://10.0.2.2:8000/   (local emulator -> host)
LLMDASH_SERVER_URL=

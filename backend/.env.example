# LLMDash Configuration
# NOTE: The backend reads ./data/.env (relative to the working directory /
# the Docker volume), NOT this file. Copy this file to data/.env, or set the
# keys via Admin Panel → API Keys.

# Configure API keys for AI providers

# DeepSeek
DEEPSEEK_API_KEY=

# Anthropic Claude
ANTHROPIC_API_KEY=

# MiniMax
MINIMAX_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=

# SearXNG instance URL (default: http://localhost:8080; http://searxng:8080 in Docker)
SEARXNG_URL=http://localhost:8080

# Database path
DATABASE_PATH=data/llmdash.db

# P4 agentic git: fixed commit author for AI-made commits (never the user's
# identity). GIT_BOT_EMAIL defaults to llmdash@<repo host> when empty.
GIT_BOT_NAME=LLMDash
GIT_BOT_EMAIL=

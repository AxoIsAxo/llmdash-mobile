# LLMDash Configuration
# Configure API keys for AI providers

# DeepSeek
DEEPSEEK_API_KEY=

# Anthropic Claude
ANTHROPIC_API_KEY=

# MiniMax
MINIMAX_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=

# SearXNG instance URL (default: http://localhost:8080)
SEARXNG_URL=http://localhost:8080

# Database path
DATABASE_PATH=data/llmdash.db

# ============================================================
# LLMDash Mobile .gitignore
# ============================================================
# Per-folder .gitignore files complement these rules:
#   - frontend/android/.gitignore   (Android-specific)
#   - frontend/android/app/.gitignore
# ============================================================

# --- Node / Vite (frontend) -----------------------------------
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# --- Environment / secrets ------------------------------------
# Never commit credentials or the build-time LLMDASH_SERVER_URL
# (it bakes into the APK).
.env
.env.local
.env.*.local
frontend/.env
frontend/.env.local
frontend/.env.*.local

# --- Capacitor / Android build outputs ------------------------
# (frontend/android/.gitignore covers most; these are belt-and-
# suspenders for the case where someone runs gradle from the
# repo root or adds new platform folders.)
*.apk
*.aab
*.ap_
*.dex
*.class
*.hprof
.gradle/
build/
local.properties
.idea/
*.iml
captures/
.cxx/
.kotlin/
.externalNativeBuild/

# --- Local tooling (venv/uv, not part of the project) ---
.uv-cache/
.uv-python/
.reasonix/

# --- IDE / editor --------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

{
  "name": "llmdash-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "mobile:prebuild": "node scripts/prebuild.mjs",
    "mobile:setup": "npm run mobile:prebuild && node scripts/setup.mjs",
    "mobile:sync": "npm run mobile:prebuild && vite build && cap sync android",
    "mobile:icons": "capacitor-assets generate",
    "mobile:build:debug": "npm run mobile:sync && cd android && ./gradlew assembleDebug",
    "mobile:build:release": "npm run mobile:sync && cd android && ./gradlew assembleRelease",
    "mobile:open:android": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/keyboard": "^7.0.0",
    "@capacitor/network": "^7.0.0",
    "@capacitor/preferences": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "capacitor-voice-recorder": "^7.0.6",
    "dompurify": "^3.4.12",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.0.0",
    "@clack/prompts": "^0.7.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "minimatch": "^10.0.3",
    "tar": "^7.5.11",
    "uuid": "^11.1.1"
  },
  "allowScripts": {
    "sharp@0.32.6": true
  }
}
